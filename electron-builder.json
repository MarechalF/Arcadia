{
  "appId": "fr.fluxpublics.app",
  "productName": "Flux Publics",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "electron/preload.cjs",
    "package.json"
  ],
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Education;Finance"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.finance"
  }
}
