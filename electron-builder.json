{
  "appId": "fr.fluxpublics.app",
  "productName": "Flux Publics",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "electron/preload.cjs",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "MarechalF",
    "repo": "Arcadia"
  },
  "win": {
    "target": ["nsis"],
    "publish": ["github"]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Flux Publics"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Education;Finance",
    "publish": ["github"]
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.finance",
    "publish": ["github"]
  }
}
